/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2){
        ListNode* mover1 = list1;
        ListNode * mover2 = list2;
        ListNode* dummy = new ListNode();
        ListNode * mover = dummy;
        while(mover1 && mover2){
            if(mover1->val <= mover2->val){
                mover->next = new ListNode(mover1->val);
                if(mover1->next)mover1 = mover1->next;
                else mover1 = nullptr;
                mover = mover->next;
            }
            else{
                mover->next=  new ListNode(mover2->val);
                if(mover2->next)mover2=mover2->next;
                else mover2 = nullptr;
                mover = mover->next;
            }
        }
        while(mover1){
            mover->next = new ListNode(mover1->val);
            mover = mover->next;
            if(mover1->next)mover1=mover1->next;
            else mover1=nullptr;
        }
        while(mover2){
            mover->next = new ListNode(mover2->val);
            mover = mover->next;
            if(mover2->next)mover2=mover2->next;
            else mover2=nullptr;
        }
        return dummy->next;
    }
};

